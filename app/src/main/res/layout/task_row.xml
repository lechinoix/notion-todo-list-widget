<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:gravity="center_vertical">
    <TextView android:id="@+id/done" android:layout_width="48dp" android:layout_height="match_parent" android:minHeight="64dp" android:text="○" android:textSize="29sp" android:textColor="@color/muted" android:gravity="center" android:contentDescription="Mark task done"/>
    <LinearLayout android:id="@+id/edit" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="64dp" android:gravity="center_vertical" android:orientation="vertical" android:paddingVertical="8dp">
        <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="15sp" android:textColor="@color/ink" android:maxLines="3" android:ellipsize="end"/>
        <TextView android:id="@+id/tags" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/muted" android:paddingTop="4dp" android:maxLines="2" android:ellipsize="end"/>
    </LinearLayout>
</LinearLayout>
